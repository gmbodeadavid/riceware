# Base SQLite locale (chemin relatif à prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions admin (32 caractères aléatoires minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="remplacer-par-un-secret-aleatoire"

# Hash bcrypt du mot de passe admin, avec chaque « $ » échappé en « \$ »
# Générer : npm run admin:hash -- "votre-mot-de-passe"
ADMIN_PASSWORD_HASH="\$2b\$12\$remplacer-par-le-hash-genere-par-admin-hash-0000000000"

# Numéro WhatsApp affiché sur le checkout (optionnel, format international sans +)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Dossier de stockage des images du blog (optionnel, défaut : storage/uploads/blog)
BLOG_UPLOAD_DIR=""
