# ── Base de données PostgreSQL (Neon) ──────────────────────────────────────
# URL poolée (utilisée par l'app Next.js en production — passe par le pooler Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# URL directe (utilisée par Prisma Migrate — connexion sans pooler)
DIRECT_URL="postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# ── Développement local (décommenter pour utiliser SQLite en local) ─────────
# DATABASE_URL="file:./prisma/dev.db"
# DIRECT_URL="file:./prisma/dev.db"

# Secret de signature des sessions admin (32 caractères aléatoires minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="remplacer-par-un-secret-aleatoire"

# Hash bcrypt du mot de passe admin, avec chaque « $ » échappé en « \$ »
# Générer : npm run admin:hash -- "votre-mot-de-passe"
ADMIN_PASSWORD_HASH="\$2b\$12\$remplacer-par-le-hash-genere-par-admin-hash-0000000000"

# Numéro WhatsApp affiché sur le checkout (optionnel, format international sans +)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Dossier de stockage des images du blog (optionnel, défaut : storage/uploads/blog)
BLOG_UPLOAD_DIR=""

# Dossier des pièces jointes production (optionnel, défaut : storage/uploads/production)
PRODUCTION_UPLOAD_DIR=""

# Mot de passe des comptes de démonstration créés par `npm run db:seed`
# S'il est absent, le mot de passe initial de démonstration reste "RiceWare2026!".
# Définir cette variable réinitialise les mots de passe des comptes de démonstration au prochain seed.
SEED_ADMIN_PASSWORD=""

# Alertes WhatsApp (optionnel). Sans URL et jeton, les notifications restent dans le back-office.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_RECIPIENT=""

# ── Blog Admin (/blog/admin) ────────────────────────────────────────────────
# Mot de passe en clair pour accéder à /blog/admin (indépendant de /admin)
BLOG_ADMIN_PASSWORD="votre-mot-de-passe-blog"

# Secret de signature des sessions blog admin (32 caractères aléatoires minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLOG_ADMIN_SECRET="remplacer-par-un-secret-aleatoire-blog"

# ── Facturation (/api/boutique-admin/orders/[id]/invoice) ───────────────────
# Coordonnées apparaissant en pied de chaque facture PDF
INVOICE_EMAIL="contact@riceware.ci"
INVOICE_PHONE="+225 00 00 00 00 00"
INVOICE_RCCM=""
