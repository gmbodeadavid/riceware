generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String        @id
  slug          String        @unique
  name          String
  category      String
  headline      String        @default("")
  summary       String
  format        String
  material      String
  image         String
  imagesByColor Json
  status        String
  currentPrice  String
  oldPrice      String
  accent        String
  sortOrder     Int           @default(0)
  isPublished   Boolean       @default(true)
  isNew         Boolean       @default(false)
  createdAt     DateTime      @default(now())
  galleryImages Json          @default("[]")
  viewsByColor  Json          @default("{}")
  model3dUrl    String?
  packs         ProductPack[]
}

model ProductCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductPack {
  id         String  @id
  productId  String
  packKey    String
  label      String
  quantity   Int
  price      String
  priceValue Int     @default(0)
  note       String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, packKey])
}

model BlogAuthor {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  bio         String?
  avatarUrl   String?
  socialLinks Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  color       String?
  parentId    String?
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[] @relation("BlogCategoryToBlogPost")
}

model BlogTag {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  color       String?
  usageCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  posts       BlogPost[] @relation("BlogPostToBlogTag")
}

model BlogMedia {
  id              String     @id @default(cuid())
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  durationSeconds Int?
  url             String
  thumbnailUrl    String?
  altText         String?
  caption         String?
  type            String
  uploadedBy      String     @default("admin")
  createdAt       DateTime   @default(now())
  featuredOn      BlogPost[]
}

model BlogPost {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  excerpt            String?
  content            Json
  status             String
  featuredImageId    String?
  authorId           String
  seoTitle           String?
  seoDescription     String?
  seoKeywords        Json?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  publishedBy        String?
  readingTimeMinutes Int            @default(1)
  viewCount          Int            @default(0)
  likeCount          Int            @default(0)
  commentCount       Int            @default(0)
  isFeatured         Boolean        @default(false)
  allowComments      Boolean        @default(true)
  version            Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  contenuHtmlEn      String?
  contenuHtmlKo      String?
  extraitEn          String?
  extraitKo          String?
  titreEn            String?
  titreKo            String?
  author             BlogAuthor     @relation(fields: [authorId], references: [id])
  featuredImage      BlogMedia?     @relation(fields: [featuredImageId], references: [id])
  categories         BlogCategory[] @relation("BlogCategoryToBlogPost")
  tags               BlogTag[]      @relation("BlogPostToBlogTag")
}

model BlogSettings {
  id                    String  @id @default("default")
  postsPerPage          Int     @default(10)
  allowComments         Boolean @default(true)
  commentModeration     Boolean @default(true)
  autoCloseCommentsDays Int     @default(30)
  defaultAuthorId       String  @default("")
  defaultCategoryId     String  @default("")
  rssEnabled            Boolean @default(true)
  rssItemsCount         Int     @default(20)
  jsonLdEnabled         Boolean @default(true)
  socialShareEnabled    Boolean @default(true)
  readingTimeEnabled    Boolean @default(true)
  relatedPostsEnabled   Boolean @default(true)
  relatedPostsCount     Int     @default(3)
}

model Customer {
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?
  addresses   Address[]
  orders      Order[]
}

model Address {
  id                   String   @id @default(cuid())
  customerId           String
  city                 String
  district             String?
  details              String?
  deliveryInstructions String?
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders               Order[]
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  customerId             String
  deliveryAddressId      String
  channel                String
  status                 String
  paymentStatus          String
  paymentPlan            String?
  deliveryOption         String?
  preferredPaymentMethod String?
  subtotalAmount         Int         @default(0)
  deliveryFeeAmount      Int         @default(0)
  totalAmount            Int         @default(0)
  currency               String      @default("XOF")
  notes                  String?
  createdAt              DateTime    @default(now())
  confirmedAt            DateTime?
  preparedAt             DateTime?
  deliveredAt            DateTime?
  cancelledAt            DateTime?
  deletedAt              DateTime?
  deletedById            String?
  deliveryAddress        Address     @relation(fields: [deliveryAddressId], references: [id])
  customer               Customer    @relation(fields: [customerId], references: [id])
  lines                  OrderLine[]
}

model OrderLine {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String?
  productPackId       String?
  packNameSnapshot    String
  packContentSnapshot Json
  quantity            Int
  unitPriceAmount     Int
  lineTotalAmount     Int
  packQuantity        Int     @default(1)
  order               Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model User {
  id             String            @id @default(cuid())
  name           String
  email          String            @unique
  passwordHash   String
  role           String            @default("reader")
  active         Boolean           @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  auditLogs      AuditLog[]
  batches        BatchProduction[] @relation("BatchOperator")
  documents      Document[]        @relation("DocumentUploader")
  lots           LotCoques[]       @relation("LotCreator")
  stockMovements StockMovement[]   @relation("MovementAuthor")
  tests          TestQualite[]     @relation("TestOperator")
}

model Rizerie {
  id              String      @id @default(cuid())
  name            String
  location        String
  contactName     String?
  contactPhone    String?
  contactEmail    String?
  contractType    String      @default("achat")
  monthlyVolumeKg Float?
  qualityNotes    String?
  notes           String?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  lots            LotCoques[]
}

model LotCoques {
  id            String            @id @default(cuid())
  code          String            @unique
  rizerieId     String
  receivedAt    DateTime
  grossWeightKg Float
  tareWeightKg  Float             @default(0)
  netWeightKg   Float
  humidityPct   Float
  visualQuality String            @default("conforme")
  status        String            @default("accepted")
  photoUrl      String?
  notes         String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  deletedById   String?
  batches       BatchProduction[] @relation("LotBatches")
  createdBy     User?             @relation("LotCreator", fields: [createdById], references: [id])
  rizerie       Rizerie           @relation(fields: [rizerieId], references: [id])

  @@index([receivedAt])
  @@index([rizerieId])
  @@index([status])
}

model BatchProduction {
  id             String        @id @default(cuid())
  code           String        @unique
  lotId          String?
  startedAt      DateTime
  productType    String        @default("assiette")
  powderKg       Float
  binderKg       Float
  mixHumidityPct Float
  pressingTempC  Float
  pressureMpa    Float
  cycleTimeMin   Float
  piecesProduced Int
  rejects        Int           @default(0)
  rejectCause    String?
  observations   String?
  powderCostFcfa Float         @default(0)
  binderCostFcfa Float         @default(0)
  laborCostFcfa  Float         @default(0)
  energyCostFcfa Float         @default(0)
  operatorId     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  operator       User?         @relation("BatchOperator", fields: [operatorId], references: [id])
  lot            LotCoques?    @relation("LotBatches", fields: [lotId], references: [id])
  products       ProduitFini[]
  tests          TestQualite[]

  @@index([startedAt])
  @@index([lotId])
}

model ProduitFini {
  id              String          @id @default(cuid())
  batchId         String
  type            String
  weightG         Float
  thicknessMm     Float
  thicknessPoints Json?
  leakTest        Boolean?
  loadTestKg      Float?
  status          String          @default("valide")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  deletedById     String?
  batch           BatchProduction @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tests           TestQualite[]

  @@index([batchId])
  @@index([status])
}

model TestQualite {
  id             String           @id @default(cuid())
  produitFiniId  String?
  batchId        String?
  typeTest       String
  result         String
  loadKg         Float?
  durationMin    Float?
  waterMl        Float?
  waterTempC     Float?
  cracks         Boolean?
  bubbles        Boolean?
  deformations   Boolean?
  thicknessAvgMm Float?
  operatorId     String?
  testedAt       DateTime         @default(now())
  notes          String?
  createdAt      DateTime         @default(now())
  operator       User?            @relation("TestOperator", fields: [operatorId], references: [id])
  batch          BatchProduction? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  produitFini    ProduitFini?     @relation(fields: [produitFiniId], references: [id], onDelete: Cascade)

  @@index([testedAt])
  @@index([batchId])
  @@index([produitFiniId])
}

model Stock {
  id           String          @id @default(cuid())
  itemType     String
  productType  String          @default("")
  label        String
  quantity     Float           @default(0)
  unit         String          @default("kg")
  minThreshold Float           @default(0)
  location     String?
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?
  deletedById  String?
  movements    StockMovement[]

  @@unique([itemType, productType])
  @@index([itemType])
}

model StockMovement {
  id                String   @id @default(cuid())
  stockId           String
  type              String
  quantity          Float
  resultingQuantity Float
  reference         String?
  note              String?
  createdById       String?
  createdAt         DateTime @default(now())
  createdBy         User?    @relation("MovementAuthor", fields: [createdById], references: [id])
  stock             Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([stockId])
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  type         String   @default("autre")
  contactName  String?
  phone        String?
  email        String?
  location     String?
  contractType String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
  deletedById  String?

  @@index([type])
}

model Document {
  id           String    @id @default(cuid())
  name         String
  category     String    @default("autre")
  url          String
  mimeType     String?
  sizeBytes    Int?
  entityType   String?
  entityId     String?
  notes        String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedById  String?
  uploadedBy   User?     @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([category])
  @@index([entityType, entityId])
}

model Goal {
  id          String    @id @default(cuid())
  label       String
  description String?
  metric      String    @default("pieces")
  target      Float
  unit        String    @default("pièces")
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  level      String   @default("info")
  title      String
  message    String
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorName  String   @default("système")
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
